__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
runs/
site/
# swebench-verified upstream has no license, so its tasks are fetched, never
# committed; terminal-bench and cl-bench tasks ARE committed (Apache-2.0) —
# only their download caches stay out.
tasks/swebench-verified/*/
tasks/cl-bench/.data/
tasks/terminal-bench/.data/
dist/
build/
.DS_Store
.vercel
.env*
